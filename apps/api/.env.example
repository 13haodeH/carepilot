# Production should point to a server-only Supabase PostgreSQL connection string.
# Keep the `postgresql+psycopg://` SQLAlchemy driver prefix and use SSL. Do not
# put a Supabase service-role key in this file or in the browser application.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/postgres?sslmode=require
# The application uses a local SQLite file only when DATABASE_URL is absent.
DATABASE_URL=sqlite:///./carepilot.db

# Required for REAL_AGENT_RUN only. This file is server-side; never add this
# value to apps/web or a NEXT_PUBLIC_ variable, and never commit .env.local.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# OPENAI_VISION_MODEL=gpt-4.1-mini-2025-04-14
# Cost accounting defaults to the model's listed input/output USD per million
# tokens. Override only when selecting a different provider/model.
# OPENAI_INPUT_USD_PER_MILLION=0.40
# OPENAI_OUTPUT_USD_PER_MILLION=1.60

# Alternative: DeepSeek's server-side OpenAI-compatible Responses API. Set
# either this group or the OPENAI_* group above, never expose either in apps/web.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# Prices below are peak, cache-miss USD per 1M tokens; override if your DeepSeek
# billing tier/time differs so persisted cost estimates remain interpretable.
# DEEPSEEK_INPUT_USD_PER_MILLION=0.44
# DEEPSEEK_OUTPUT_USD_PER_MILLION=1.32

# Supabase Auth verification and one-time local demo-account provisioning.
# The secret key is server-only. The three password values are optional and are
# only read by scripts/provision_demo_auth.py; they are never persisted by the app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=
CARE_PILOT_DEMO_USER_PASSWORD=
CARE_PILOT_DEMO_ADMIN_PASSWORD=
CARE_PILOT_DEMO_SUPERADMIN_PASSWORD=
